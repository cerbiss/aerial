# Copy the names into Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Stripe (Dashboard → Developers → API keys). sk_test_… for testing, sk_live_… in production.
STRIPE_SECRET_KEY=
# Stripe (Developers → Webhooks → endpoint https://<your-site>/api/stripe-webhook,
# event checkout.session.completed) → "Signing secret" whsec_…
STRIPE_WEBHOOK_SECRET=

# PayPal (developer.paypal.com → Apps & Credentials, a Business account app)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox while testing, live in production
PAYPAL_ENV=sandbox

# Optional: https://<your-domain> (otherwise taken from the request host)
SITE_URL=
# Optional: a Discord channel webhook that gets a message for every new order
ORDER_WEBHOOK_URL=
